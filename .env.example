# Copy to .env for local development: cp .env.example .env
# .env.local is optional and takes priority over .env.

# Controls the database mode. "development" uses TypeORM synchronize with no SSL.
# Any other value, or leaving it unset, turns on SSL and runs migrations at boot.
ENVIRONMENT=development

# Port the API listens on. Compose publishes 3000, so change both together.
PORT=3000

# Browser origins allowed to call the API, comma-separated with no trailing slash.
# Defaults to http://localhost:4200, the frontend's dev server.
CORS_ORIGINS=http://localhost:4200

# Postgres container credentials, used by Compose.
POSTGRES_DB=flights_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# API database connection for commands run on the host (5433 is the published port).
# Compose overrides these inside the API container with DB_HOST=db and DB_PORT=5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=flights_management
DB_USER=postgres
DB_PASSWORD=postgres

# S3 storage for airplane file uploads. Set your real region; it must not be blank or
# the API crashes at startup. Uploads fail until the other three values are set.
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional. Minutes past its departure before a flight still on the ground is marked delayed.
# Defaults to 15.
DELAY_TOLERANCE_MINUTES=

# Optional. Where npm run airports:import downloads the OurAirports CSVs from.
# Defaults to https://davidmegginson.github.io/ourairports-data
OURAIRPORTS_BASE_URL=

# Optional. Leave empty to disable Application Insights.
APPLICATION_INSIGHTS_CONNECTION_STRING=
